# Copy to ".env" on the server and fill in your EC2 public IP (dashes, not dots).
# sslip.io resolves 13-250-1-2.sslip.io → 13.250.1.2 automatically, which lets
# Caddy issue a real HTTPS certificate without buying a domain.
#
#   cp .env.deploy.example .env   &&   edit .env
#
SITE_ADDRESS=13-250-1-2.sslip.io
