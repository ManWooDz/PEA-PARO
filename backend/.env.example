# Copy to .env and run:  uvicorn main:app --port 8000 --env-file .env
# (uvicorn[standard] loads the file; values become process env vars.)

# ── LINE Messaging API (Tab 4 notifications) ─────────────────────────────────
# Create a Messaging API channel under a LINE Official Account, then paste the
# long-lived Channel access token + the destination userId/groupId here.
# Leave blank → the /api/notify/line endpoint runs in simulated/preview mode.
# Docs: https://developers.line.biz/en/docs/messaging-api/
LINE_CHANNEL_ACCESS_TOKEN=
LINE_TARGET_ID=

# ── Simulation clock (demo) ──────────────────────────────────────────────────
# Freeze "now" to a fixed instant inside the dataset (default = start of the
# forecast test window). Set PEA_LIVE=1 to use real wall-clock time instead.
# PEA_SIM_NOW=2025-12-28T09:15:00
# PEA_LIVE=1
